{
  "name": "MelodicBook - Music Streaming Platform",
  "short_name": "MelodicBook",
  "description": "Your ultimate music streaming platform with AI-powered recommendations",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#1a0b2e",
  "theme_color": "#1a0b2e",
  "orientation": "portrait-primary",
  "categories": ["music", "entertainment", "audio"],
  "lang": "en-US",
  "icons": [
    {
      "src": "/icon-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-96.png", 
